// carservice.mn — multi-tenant авто үйлчилгээний платформын schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Tenant ---------------------------------------------------------------

model Tenant {
  id                             String   @id @default(cuid())
  slug                           String   @unique
  // Байгууллагын нэр — DB түвшинд unique биш (хоёр өөр компани адилхан нэртэй
  // байх нь бодит боломжтой). Давхцлыг зөвхөн бүртгэлийн UX түвшинд (signUpAction)
  // шалгаж, тодорхой мессеж өгдөг — бизнесийн шийдвэрээр constraint аваагүй.
  name                           String
  registerNumber                 String   @unique // 7 оронтой улсын бүртгэлийн дугаар (string-р хадгална)
  email                          String   @unique
  phone1                         String
  phone2                         String?
  logoUrl                        String?
  plan                           Plan     @default(FREE)
  suspended                      Boolean  @default(false) // super admin-аар түр зогсоосон эсэх
  acceptsOnlineBooking           Boolean  @default(false) // Онлайн цаг захиалгын каталогт харагдах эсэх
  // Цаг захиалгын сануулга SMS/мэдэгдлийг товлосон цагаас хэдэн минутын
  // өмнө илгээхийг тенант өөрөө тохируулна — 24 цагаас (1440) их байж болно
  // (жиш. 1 хоног 6 цаг = 1800). Минутаар хадгалснаар 24ц-аас хязгаарлагдахгүй
  // (харах: app/api/cron/appointment-reminders/route.ts).
  appointmentReminderLeadMinutes Int      @default(1440)
  // Идэвхтэй банкны кодууд (lib/banks.ts). Хоосон = бүх банк идэвхтэй.
  enabledBanks                   String[] @default([])
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  users                    User[]
  roles                    Role[]
  branches                 Branch[]
  customers                Customer[]
  tenantVehicles           TenantVehicle[]
  services                 Service[]
  serviceOrders            ServiceOrder[]
  serviceOrderCategories   ServiceOrderCategory[]
  orderTimeBookings        OrderTimeBooking[]
  diagnosticTemplates      DiagnosticTemplate[]
  diagnosticTemplateGrants DiagnosticTemplateGrant[]
  diagnosticReports        DiagnosticReport[]
  units                    Unit[]
  categories               Category[]
  subscriptions            Subscription[]
  subscriptionPayments     SubscriptionPayment[]
  auditLogs                AuditLog[]
  qpaySettings             TenantQPaySettings?
  orderPayments            OrderPayment[]
  cashTransactionTypes     CashTransactionType[]
  cashTransactions         CashTransaction[]
  postpaidSettlements      PostpaidSettlement[]
  cashSessions             CashSession[]
  appointments            Appointment[]
  appointmentPayments      AppointmentPayment[]
  notifications            Notification[]
  feedback                 Feedback[]
  feedbackMessages         FeedbackMessage[]
}

enum Plan {
  FREE
  BUSINESS
  ENTERPRISE
}

// --- User -----------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  firstName    String // Нэр
  lastName     String // Овог
  // Канон 8 оронтой формат (lib/phone.ts). Бүх ажилтанд давхцахгүй (глобал).
  phone        String  @unique
  // Админ ажилтан үүсгэхэд нууц үг тавихгүй — ажилтан анх удаа нэвтрэхдээ
  // өөрөө үүсгэнэ (OTP-ээр). Тиймээс идэвхжих хүртэл null.
  passwordHash String?
  // Ажилтан утсаараа OTP авч нууц үгээ үүсгэж аккаунтаа идэвхжүүлсэн эсэх.
  // false бол паролиар нэвтэрч чадахгүй — эхлээд идэвхжүүлэх ёстой.
  verified     Boolean @default(false)

  // Тенант бүртгүүлсэн админ. Бүх эрхтэй, ямар ч role-той эсэхээс үл хамаарна.
  // Үүрэг сольж болохгүй, устгахгүй (сүүлийн админыг үлдээх ёстой).
  isOwner Boolean @default(false)

  // Тенант доторх өөрийн үүсгэсэн Role-той холбоо. isOwner=true бол null байж болно.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Buffer-аас бус нэвтрэх алдааны тоо. 5 алдаа нэрсэн үед lockedAt тогтоосноор
  // нэвтрэх боломжгүй болж, нууц үгээ сэргээх замаар л сэргэдэг.
  failedLoginAttempts Int       @default(0)
  lockedAt            DateTime?

  // Гар түр хаах flag. true бол ажилтан хэвийн ажиллана. Манагер цаг
  // үе гарваал false болгож login-г блоклож болно (бичлэг нь хадгалагдана).
  isActive    Boolean   @default(true)
  // Түр ажиллах ажилтан үүсгэх үед энэ огноо тогтооно. Энэ огнооноос хойш
  // нэвтрэх оролдлого хийвэл automatically блоклогдоно. null бол байнгын.
  activeUntil DateTime?
  // Хэрэглэгч өөрөө түр хаасан. Дахин нэвтрэхэд null болно (isActive-аас тусдаа —
  // isActive=false бол админ блоклосон, нэвтрэлтээр сэргэхгүй).
  deactivatedAt DateTime?
  // Бүрмөсөн устгасан (PII арилгасан tombstone). Буцаагдахгүй.
  deletedAt     DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  // Үндсэн салбар (дээрх branchId)-аас гадна энэ ажилтныг захиалгад хариуцагчаар
  // сонгож болох НЭМЭЛТ салбаруудын id (олон салбарт дамжиж ажилладаг мастер).
  // Зөвхөн order-form-ийн "Хариуцах мастер" сонголтод ашиглагдана — өгөгдөл
  // хандалтын хамрах хүрээг (branchScopeId) өөрчлөхгүй. FK constraint-гүй тул
  // салбар устахад энд үлдэж болзошгүй — ашиглах үедээ tenant-ийн идэвхтэй
  // салбаруудтай тааруулж шүүнэ.
  assignableBranchIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedOrders           ServiceOrder[]              @relation("AssignedTo")
  intakeRecordedOrders     ServiceOrder[]              @relation("IntakeRecordedBy")
  diagnosticTemplates      DiagnosticTemplate[]        @relation("DiagnosticTemplateCreatedBy")
  diagnosticReports        DiagnosticReport[]          @relation("DiagnosticReportFilledBy")
  cancelledServiceItems    ServiceItem[]               @relation("ServiceItemCancelledBy")
  cashEntriesCreated       CashTransaction[]           @relation("CashTransactionCreatedBy")
  cashEntriesVoided        CashTransaction[]           @relation("CashTransactionVoidedBy")
  postpaidSettlementsCreated PostpaidSettlement[]      @relation("PostpaidSettlementCreatedBy")
  postpaidSettlementsVoided PostpaidSettlement[]       @relation("PostpaidSettlementVoidedBy")
  cashSessionsOpened       CashSession[]               @relation("CashSessionOpenedBy")
  cashSessionsClosed       CashSession[]               @relation("CashSessionClosedBy")
  refreshTokens            RefreshToken[]
  sessions                 UserSession[]
  devices                  Device[]
  notifications            Notification[]
  auditLogs                AuditLog[]                  @relation("AuditLogActor")
  appointmentsResponded    Appointment[]               @relation("AppointmentRespondedBy")
  appointmentsAssigned     Appointment[]               @relation("AppointmentAssignedTo")
  feedback                 Feedback[]
  createdOrderTimeBookings OrderTimeBooking[]          @relation("OrderTimeBookingCreatedBy")
  workSchedule             EmployeeWorkSchedule[]
  scheduleExceptions       EmployeeScheduleException[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, isOwner])
  @@index([roleId])
  @@index([activeUntil])
}

// --- Role (тенант бүрийн өөрийн үүсгэдэг хэрэглэгчийн үүрэг) -------------
// Админ (isOwner=true) бүртгэлийн дараа байгууллагынхаа онцлогт тохируулан
// Role үүсгэж, permission массивыг сонгоно. Ажилтан үүсгэх үед эдгээрээс
// сонгоно. OWNER үргэлж бүх эрхтэй, тусдаа Role үүсэхгүй.

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Permission code-уудын массив. Кодын жагсаалт нь `lib/auth/permissions.ts`
  // дотор төвлөрсөн (ж: "orders.manage", "audit.view").
  permissions String[]
  isActive    Boolean  @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// --- Branch ---------------------------------------------------------------

model Branch {
  id        String  @id @default(cuid())
  name      String
  phone     String?
  isPrimary Boolean @default(false) // Тенант тус бүрд нэг л үндсэн салбар байна
  // Ажиллахаа больсон салбарыг устгахгүйгээр "нуух" — Restrict-оор Branch устгах
  // хаалттай тул ажиллагаагүй болсон салбарыг идэвхгүй болгож жагсаалт/сонголтоос
  // хасна (өгөгдөл, түүх хадгалагдана).
  isActive  Boolean @default(true)

  // --- Хаяг ---
  city     String? // Хот / Аймаг (жишээ: "Улаанбаатар")
  district String? // Дүүрэг / Сум (жишээ: "Баянзүрх")
  khoroo   String? // Хороо / Баг (жишээ: "6-р хороо")
  address  String? // Дэлгэрэнгүй (гудамж, тоот, баримжаа)

  // --- Газарзүйн байршил ---
  latitude  Float?
  longitude Float?

  // --- Ажиллах цаг (default) ---
  // Өдөр тус бүрийн цагийг BranchSchedule дээр override хийж болно.
  openTime  String? // "HH:MM" (24 цагийн) — default
  closeTime String? // "HH:MM" (24 цагийн) — default

  // --- Онлайн цаг захиалгын slot тохиргоо ---
  slotMinutes  Int? // нэг цагийн нүхний урт (минут). null бол 30.
  slotCapacity Int? // нэг нүхэнд зэрэг авах захиалгын тоо. null бол 1.

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                             User[]
  serviceOrders                     ServiceOrder[]
  cashTransactions                  CashTransaction[]
  postpaidSettlements               PostpaidSettlement[]
  cashSessions                      CashSession[]
  diagnosticReports                 DiagnosticReport[]
  schedules                       BranchSchedule[]
  scheduleExceptions                BranchScheduleException[]
  scheduleSeasons                   BranchScheduleSeason[]
  auditLogs                         AuditLog[]
  appointments                      Appointment[]
  categories                        Category[] // олон-олон: энэ салбарт санал болгох ангилалууд
  tags                              BranchTag[] // олон-олон: энэ салбарын бизнесийн төрлийн шошго
  orderTimeBookings                 OrderTimeBooking[]
  employeeWorkScheduleSegments      EmployeeWorkScheduleSegment[]
  employeeScheduleExceptionSegments EmployeeScheduleExceptionSegment[]

  @@index([tenantId])
}

// --- BranchSchedule (Branch-ийн өдрийн ажиллах хуваарь) ------------------
// Тус салбарын долоо хоногийн өдөр тус бүрт нэг л бичлэг. Энэ нь Int[]
// талбараас илүү — өдөр тус бүрийн нээх/хаах цагийг тусад нь override хийх
// боломжтой, мөн "Ням гарагт ажилладаг бүх салбар" гэх мэт шүүлт хийхэд
// index-тэй.

enum Weekday {
  SUN
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model BranchSchedule {
  id        String  @id @default(cuid())
  weekday   Weekday
  isOpen    Boolean @default(false)
  openTime  String? // "HH:MM" — null бол branch-ийн default
  closeTime String? // "HH:MM" — null бол branch-ийн default

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, weekday])
  @@index([weekday, isOpen])
}

// Нэг удаагийн онцгой өдөр — баяр, амралт, эсвэл тухайн өдрийн тусгай цаг.
// Нээлттэй бол цагийг заавал тодорхойлно; хаалттай бол цаг null байна.
model BranchScheduleException {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  isOpen    Boolean  @default(false)
  openTime  String?
  closeTime String?
  label     String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, date])
  @@index([branchId, date])
}

// Нэг салбарын давхцахгүй улирлын хүрээ. Өдрийн мөргүй бол үндсэн долоо
// хоногийн дүрмийг өвлөнө.
model BranchScheduleSeason {
  id       String   @id @default(cuid())
  name     String
  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date
  isActive Boolean  @default(true)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  days      BranchScheduleSeasonDay[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([branchId, startsOn, endsOn])
  @@index([branchId, isActive])
}

model BranchScheduleSeasonDay {
  seasonId  String
  season    BranchScheduleSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  weekday   Weekday
  isOpen    Boolean              @default(false)
  openTime  String?
  closeTime String?

  @@id([seasonId, weekday])
  @@index([weekday, isOpen])
}

// --- EmployeeWorkSchedule (ажилтны долоо хоногийн ажлын хувиар) ----------
// Ажилтан бүрийн гараг тус бүрд "аль салбар(уудад) ажилладаг" override — мөр
// байхгүй гараг бол ажилтны өөрийн (`User.branchId`) салбарт байнга ажилладаг
// гэж үзнэ. Нэг өдөр хэд хэдэн салбарт (өөр өөр цагаар) ажиллаж болдог тул
// цаг/салбарыг `segments`-д (child хүснэгт) хадгална — энэ мөр зөвхөн
// `isWorking`-г эзэмшинэ (false = бүх өдөр амарна, segments хоосон байна).
// Шатлал (өндрөөс нам руу): EmployeeScheduleException (тухайн өдөр) → энэ мөр
// (гараг) → User.branchId (platform default). Харах: lib/employee-schedule.ts.
model EmployeeWorkSchedule {
  id        String  @id @default(cuid())
  weekday   Weekday
  isWorking Boolean @default(true) // false = энэ гарагт ажилладаггүй (амарна)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  segments EmployeeWorkScheduleSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekday])
  @@index([userId])
}

// Нэг өдрийн дотор ажилтан хэд хэдэн салбарт дамжиж ажиллаж болох тул
// (ж: өглөө 1-р салбар, өдөр 2-р салбар) EmployeeWorkSchedule/
// EmployeeScheduleException мөр тус бүр олон segment-тэй байж болно.
// `startTime`/`endTime` хоосон бол тухайн segment-ийн салбарын өөрийнх нь
// тухайн өдрийн цагаар (BranchSchedule-ээс тооцоологдоно) автоматаар дүүрнэ.
model EmployeeWorkScheduleSegment {
  id         String               @id @default(cuid())
  order      Int                  @default(0) // харагдах дараалал (1-р, 2-р ээлж)
  startTime  String? // "HH:MM"
  endTime    String?
  scheduleId String
  schedule   EmployeeWorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
  @@index([branchId])
}

// Нэг удаагийн онцгой өдөр (`BranchScheduleException`-той адил санаа) —
// ажилтны тухайн гарагийн ердийн (`EmployeeWorkSchedule`) дүрмийг ганц
// өдрөөр дарж бичнэ (ж: ээлж түр солих, чөлөө).
model EmployeeScheduleException {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  isWorking Boolean  @default(true)
  label     String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  segments EmployeeScheduleExceptionSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model EmployeeScheduleExceptionSegment {
  id          String                    @id @default(cuid())
  order       Int                       @default(0)
  startTime   String?
  endTime     String?
  exceptionId String
  exception   EmployeeScheduleException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch                    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([exceptionId])
  @@index([branchId])
}

// --- Customer -------------------------------------------------------------

model Customer {
  id       String  @id @default(cuid())
  fullName String
  phone    String
  email    String?
  note     String?

  // Байгууллага (НӨАТ-ын баримтад) — Phase 2+.
  isOrganization Boolean @default(false)
  orgRegnum      String?
  orgName        String?
  orgEmail       String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Онлайн цаг захиалгын global Account-той гүүр. null бол ажилтан гар аргаар
  // үүсгэсэн (аккаунтгүй) Customer. Тенант тус бүрд нэг Account-д нэг Customer.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantVehicles    TenantVehicle[]
  serviceOrders     ServiceOrder[]
  cashTransactions  CashTransaction[]
  postpaidSettlements PostpaidSettlement[]
  diagnosticReports DiagnosticReport[]
  appointments      Appointment[]

  // "Эзэнгүй" (accountId IS NULL, ажилтан гар аргаар үүсгэсэн walk-in) Customer-уудын
  // дунд tenant+phone unique — migration-д partial unique index-ээр хэрэгждэг
  // (Prisma schema DSL филтэртэй index илэрхийлэх боломжгүй тул):
  // CREATE UNIQUE INDEX "Customer_tenantId_phone_unclaimed_key" ON "Customer"("tenantId", phone) WHERE "accountId" IS NULL;
  // accountId-тэй мөрүүд үүнд ороогүй — өөр өөр Account ижил утас ашиглах хууль ёсны.
  @@unique([tenantId, accountId])
  @@index([tenantId, phone])
  @@index([tenantId, orgRegnum])
}

// --- Vehicle --------------------------------------------------------------

// "Нэг эзэмшигчийн нэг машины бүртгэл" — глобал (tenant-гүй) мөр. Ижил эзэн
// (account/утас тохирсон) олон tenant-д үйлчлүүлсэн ч НЭГ мөр хэвээр
// (`resolveVehicleForOwner`), харин машин зарагдаж ШИНЭ эзэн бүртгэхэд —
// дугаар солигдсон эсэхээс үл хамааран — ШИНЭ мөр үүснэ. Тиймээс `plate`,
// `vin` глобал давтагдашгүй БИШ: ижил физик машин хэд хэдэн эзэмшлийн мөртэй
// байж болно. Засварын түүх (ServiceOrder/DiagnosticReport/Appointment) мөр
// рүү холбогдох тул өмнөх эзний түүх өмнөх мөрөнд үлдэж, шинэ эзэнд харагдахгүй.
// Улсын дугаар бүртгэсний дараа ХӨДӨЛШГҮЙ (ажилтан ч, хэрэглэгч ч засахгүй) —
// буруу бол устгаж дахин бүртгэнэ. Харьяалал (эзэмшигч) болон tenant-ийн
// context нь [[TenantVehicle]] дээр; тус бүр өөрийн `tenantId`-аар scope
// хийгдэнэ — dashboard tenant хооронд харагдахгүй; cross-tenant түүх зөвхөн
// машины эзэн (Account)-д.
model Vehicle {
  id            String  @id @default(cuid())
  // Арлын дугаар (cabinNumber). Эзэмшлийн мөр бүрт давхардаж болно.
  vin           String?
  // Улсын дугаар (канон: normalizePlate). Бүртгэсний дараа солигдохгүй.
  plate         String
  make          String
  model         String
  year          Int?
  mileage       Int? // сүүлд мэдэгдсэн гүйлт (аль ч tenant шинэчилж болно)
  fuelType      String? // "Бензин", "Дизель", "Хийн", "Цахилгаан" гэх мэт (HUR-аас татна)
  wheelPosition String? // "Зүүн" / "Баруун" — жолооны хүрд аль талд (HUR-аас татна)
  colorName     String? // Өнгө (HUR colorName — ж: "Цагаан")
  capacity      Int? // Моторын хэмжээ, см³ (HUR capacity — ж: 1496)
  purpose       String? // Зориулалт (HUR purpose — ж: "Суудал")
  // Эзэмшигчийн регистр (HUR ownerRegnum). 7 оронтой цэвэр тоо бол байгууллага,
  // үсэг агуулсан бол хувь хүн — харьяаллыг `ownerKindFromRegnum` тодорхойлно.
  ownerRegnum   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantLinks       TenantVehicle[]
  accountLinks      AccountVehicle[]
  serviceOrders     ServiceOrder[]
  diagnosticReports DiagnosticReport[]
  appointments      Appointment[]

  @@index([plate])
  @@index([vin])
}

// --- TenantVehicle (tenant ↔ Vehicle холбоо) ------------------------------
// Tenant бүрийн "өөрийн харагдац": тухайн байгууллагад энэ машин хэний (Customer)
// эзэмшил вэ, тэмдэглэл г.м. Харьяалал нь Vehicle дээр БИШ, энд хадгалагдана.
// `customerId` нэгэнт тавигдсан бол дарж бичигдэхгүй (`ensureTenantVehicle`) —
// эзэн солигдвол түүх шилжихгүй, шинэ эзэнд шинэ Vehicle мөр бүртгэнэ.
model TenantVehicle {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  notes      String?
  isActive   Boolean @default(true)
  // Дараа төлбөрт (гэрээт) машин — захиалгын төлбөрийг сар/гэрээгээр нэгтгэн
  // төлдөг. Захиалга үүсэхэд ServiceOrder.isPostpaid руу snapshot хийгдэнэ.
  isPostpaid Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, vehicleId])
  @@index([tenantId])
  @@index([customerId])
}

// --- ServiceOrder ---------------------------------------------------------

model ServiceOrder {
  id                       String        @id @default(cuid())
  number                   String
  status                   OrderStatus   @default(SCHEDULED)
  paymentStatus            PaymentStatus @default(UNPAID)
  // Үүсгэх үеийн TenantVehicle.isPostpaid snapshot — дараа төлбөрт түүх
  // тогтвортой үлдэнэ (машины тохиргоо хожим өөрчлөгдсөн ч).
  isPostpaid               Boolean       @default(false)
  // Дотоод (өөрийн) захиалга — Phase 2-т UI гарна. isPostpaid-тэй хамт үнэн байж болохгүй
  // (migration-ийн CHECK constraint "ServiceOrder_internal_not_postpaid").
  isInternal               Boolean       @default(false)
  // Захиалга үүсэх үеийн машины улсын дугаар / арлын дугаарын snapshot.
  plateSnapshot            String?
  vinSnapshot              String?
  scheduledAt              DateTime?
  startedAt                DateTime?
  completedAt              DateTime?
  // Scheduling v1: immutable initial estimate; null for legacy/unestimated orders.
  estimatedDurationMinutes Int?
  // Staff-revisable forecast, never a replacement for completedAt or the booking time.
  expectedFinishAt         DateTime?
  // Physical workspace occupancy: null = not recorded, false = explicitly released.
  // Independent of payment/workflow status; completion does not prove the bay is clear.
  occupiesCapacity         Boolean?
  paidAt                   DateTime?
  notes                    String?
  // QA #14: машин хүлээн авах үеийн чөлөөт тэмдэглэл (гүйлт, шатахуун, гэмтэл…).
  intakeNotes              String?
  // Хүлээн авах хэсэг зөвхөн захиалга үүсгэх үед бичигдэж, дараа нь түгжигдэнэ.
  intakeRecordedAt         DateTime?
  intakeRecordedById       String?
  intakeRecordedBy         User?         @relation("IntakeRecordedBy", fields: [intakeRecordedById], references: [id], onDelete: SetNull)
  intakeSignaturePath      String?
  // Хүлээн авах үеийн гүйлт (км, 0–2,000,000). Заавал биш.
  intakeMileageKm          Int?
  totalAmount              Decimal?      @db.Decimal(12, 2)
  paidAmount               Decimal?      @db.Decimal(12, 2)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  items        ServiceItem[]
  categories   ServiceOrderCategory[]
  timeBookings OrderTimeBooking[]
  reports      DiagnosticReport[]
  payments     OrderPayment[]
  appointment  Appointment?
  intakePhotos ServiceOrderIntakePhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, isPostpaid])
  @@index([tenantId, isInternal])
  @@index([tenantId, plateSnapshot])
  @@index([branchId, scheduledAt])
  // FK-ууд — харилцагч/машины түүх, техникчийн ажил, Restrict cascade шалгалт.
  @@index([customerId])
  @@index([vehicleId])
  @@index([assignedToId])
}

enum OrderStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// --- ServiceItem (line item) ----------------------------------------------

model ServiceItem {
  id          String            @id @default(cuid())
  kind        ItemKind
  description String
  quantity    Decimal           @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal           @db.Decimal(12, 2)
  total       Decimal           @db.Decimal(12, 2)
  // Мөрийн явц: хүлээгдэж буй → эхэлсэн → дууссан, эсвэл цуцлагдсан (харах:
  // доорхи cancelledAt/cancelledById). Захиалгын нийт дүн (ServiceOrder.
  // totalAmount) CANCELLED мөрийн total-ыг ХАСЧ тооцно.
  status      ServiceItemStatus @default(PENDING)

  // Мөрийн гүйцэтгэх хугацаа хэмжихэд (жишээ: "нэг ажил дунджаар хэдэн минут
  // авдаг" тайлан) ашиглана — статус чөлөөтэй, дурын дарааллаар (тэр дундаа
  // буцаж) солигддог тул "анх удаа" биш "одоогийн төлөвт нийцсэн" утга гэж
  // үзнэ: PENDING руу буцвал хоёуланг нь цэвэрлэнэ, IN_PROGRESS анх ороход
  // л startedAt тавигдана (дараа дахин орвол хэвээр), COMPLETED болгонд
  // completedAt шинэчлэгдэнэ. `startedAt` хоосон (ж: оношилгоо шууд
  // PENDING→COMPLETED болсон) мөрийг "хугацаа хэмжигдээгүй" гэж үзэж дундаж
  // тооцооноос хасна. Харах: lib/orders.ts-ийн serviceItemTimingPatch.
  startedAt   DateTime?
  completedAt DateTime?

  // Энэ мөр (COMPLETED, `service.reminderIntervalMonths` тохируулсан) дээр
  // "дараагийн үйлчилгээний сануулга" push-г үйлчлүүлэгчид ЯГ НЭГ л удаа
  // илгээсэн эсэх — cron дахин давхардуулж илгээхгүй байхын баталгаа (харах:
  // app/api/cron/service-reminders/route.ts).
  reminderSentAt DateTime?

  orderId String
  order   ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  // Оношилгооны загвараас үүссэн мөр (kind=DIAGNOSTIC) хаанаас гаралтайг мөн
  // бөглөгдсөн тайлантай бол аль тайлантайгаа холбоно (DiagnosticReport). Энэ
  // хоёр талбар нь урьд тусдаа OrderDiagnostic (товлосон, үнэгүй) моделийг
  // ServiceItem-тэй нэгтгэсний үр дүн — "Оношилгоо" (үнэтэй мөр) ба
  // "Оношилгооны хуудас" (бөглөх ёстой тайлан) нэг мөрийн 2 тал болно.
  diagnosticTemplateId String?
  diagnosticTemplate   DiagnosticTemplate? @relation(fields: [diagnosticTemplateId], references: [id], onDelete: SetNull)
  diagnosticReportId   String?             @unique
  diagnosticReport     DiagnosticReport?   @relation(fields: [diagnosticReportId], references: [id], onDelete: SetNull)

  // Цуцлагдсан түүх — мөрийг устгахгүй, зөвхөн CANCELLED болгож хэн/хэзээ
  // цуцалсныг хадгална.
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("ServiceItemCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([serviceId])
  @@index([status])
  @@index([diagnosticTemplateId])
}

enum ItemKind {
  LABOR
  DIAGNOSTIC
  PART
  FEE
}

enum ServiceItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// --- Service (Үйлчилгээ — Ажил/Оношилгоо/Сэлбэг-Бараа нэгдсэн каталог) ---

model Service {
  id          String      @id @default(cuid())
  type        ServiceKind
  name        String
  code        String? // SKU/код — Бараанд хэрэглэх (заавал биш)
  price       Decimal     @db.Decimal(12, 2) // зарах үнэ
  costPrice   Decimal?    @db.Decimal(12, 2) // өртөг (зөвхөн GOODS)
  stock       Decimal?    @db.Decimal(12, 3) // нөөц (зөвхөн GOODS)
  description String?
  isActive    Boolean     @default(true)

  // Зарагдах хэмжих нэгж — LABOR/GOODS-д заавал (DB-д nullable, app дээр шалгана)
  unitId String?
  unit   Unit?   @relation("ServiceUnit", fields: [unitId], references: [id], onDelete: SetNull)

  // Ажил хийгдэх хугацаа (LABOR-д заавал биш) — утга + нэгж
  durationValue  Decimal? @db.Decimal(12, 3)
  durationUnitId String?
  durationUnit   Unit?    @relation("ServiceDurationUnit", fields: [durationUnitId], references: [id], onDelete: SetNull)

  // Энэ үйлчилгээг ямар давтамжтай дахин хийлгэх ёстойг (сараар) заавал биш
  // тохируулна — жишээ нь "Тос солиулах" → 6. `null` бол сануулга огт
  // ажиллахгүй. Тохируулсан бол тухайн үйлчилгээ дууссан ServiceItem мөр
  // бүрт (completedAt-аас хойш ийм олон сар өнгөрсний дараа) үйлчлүүлэгчид
  // НЭГ удаа push сануулга илгээнэ (харах: app/api/cron/service-reminders/
  // route.ts, ServiceItem.reminderSentAt).
  reminderIntervalMonths Int?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Ангилал — бүх төрөлд (app-level дээр заавал; хуучин мөрийн улмаас DB-д nullable)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ServiceItem[]

  @@unique([tenantId, type, code])
  @@index([tenantId, type, isActive])
  @@index([tenantId, name])
  @@index([categoryId])
  @@index([unitId])
  @@index([durationUnitId])
}

enum ServiceKind {
  LABOR
  DIAGNOSTIC
  GOODS
}

// --- DiagnosticTemplate (тенант өөрөө зохиосон, эсвэл систем admin-аас ------
// байгууллагуудад олгосон оношилгооны хуудас) ------------------------------

model DiagnosticTemplate {
  id              String         @id @default(cuid())
  name            String
  description     String?
  type            DiagnosticType
  schema          Json // {sections:[{id,title,items:[{id,label,type,required,options?}]}]}
  version         Int            @default(1)
  isActive        Boolean        @default(true)
  price           Decimal?       @db.Decimal(12, 2) // үйлчилгээний үнэ — захиалгад нэмэх үед хэрэглэнэ
  durationMin     Int? // дундаж хугацаа (минут)
  // Системийн үндсэн загвар (signup дээр автоматаар үүсдэг) эсэх — тенант
  // өөрөө засах/устгах боломжгүй (харах: app/_actions/diagnostic-templates.ts).
  isSystemDefault Boolean        @default(false)

  // NULL = систем admin-аас үүсгэсэн, олон байгууллагад хуваалцсан загвар
  // (харах: DiagnosticTemplateGrant) — `isSystemDefault`-аас ялгаатай: энд
  // тенант бүрт тусдаа хуулбар ҮҮСДЭГГҮЙ, нэг мөрийг хэд хэдэн тенант
  // ХУВААЛЦДАГ. Заавал тенанттай бол ердийн тухайн тенантын өөрийн загвар.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Ангилал — бүх үйлчилгээтэй нэгэн адил (app-level дээр заавал; DB nullable).
  // Систем-үүдийн (tenantId=NULL) загварт хэрэглэгддэггүй (ангилал тенант тус
  // бүрийн өөрийн ангилал тул).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("DiagnosticTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Систем admin-аас үүсгэсэн бол (tenantId=NULL үед л утгатай) — аль admin үүсгэснийг хадгална.
  createdBySystemAdminId String?
  createdBySystemAdmin   SuperAdmin? @relation(fields: [createdBySystemAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports    DiagnosticReport[]
  orderItems ServiceItem[]
  grants     DiagnosticTemplateGrant[]

  @@index([tenantId, type, isActive])
  @@index([categoryId])
}

// Систем admin-аас үүсгэсэн загварыг (tenantId=NULL) аль байгууллага
// ашиглаж болохыг тохируулна — тухайн тенант зөвхөн уншиж, оношилгоо
// бөглөхөд хэрэглэнэ (засах/устгах боломжгүй, харах: app/_actions/
// system-diagnostic-templates.ts, app/_actions/diagnostic-templates.ts-ийн
// tenantVisibleTemplateWhere).
model DiagnosticTemplateGrant {
  templateId String
  template   DiagnosticTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@id([templateId, tenantId])
  @@index([tenantId])
}

enum DiagnosticType {
  INTAKE
  POST_SERVICE
  ROUTINE
  DAMAGE_REPORT
}

// --- DiagnosticReport (бөглөгдсөн хуудас, захиалгад хавсаргана) -----------

// Тайлан доторх check хариултуудаас хамгийн муу (worst) өнгийг тайлангийн
// түвшинд урьдчилан тооцож хадгална — жагсаалтыг DB түвшинд шүүхэд (worker
// web-ийн "яаралтай"-аар шүүх функц) ашиглана. Тайлангийн `data` нь дур
// зоргоороо key-тэй JSON тул SQL-ээр шууд шүүх боломжгүй, тиймээс бичих
// үедээ нэг удаа тооцоолж хадгална (харах: lib/diagnostics.ts-ийн
// computeReportSeverity, app/_actions/diagnostic-reports.ts). Тайлан
// өөрчлөгддөггүй (edit action байхгүй) тул дахин тооцох шаардлагагүй.
enum ReportSeverity {
  GOOD
  WARN
  BAD
}

// QA #14: машин хүлээн авах үеийн зургууд (тоо хязгааргүй биш — lib/orders/order-intake.ts).
model ServiceOrderIntakePhoto {
  id       String @id @default(cuid())
  tenantId String
  orderId  String
  order    ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  path     String   @unique

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([tenantId])
}

model DiagnosticReport {
  id              String          @id @default(cuid())
  templateVersion Int
  data            Json // {[itemId]: {value?, photos?, note?}}
  maxSeverity     ReportSeverity? // check хариултуудын хамгийн муу өнгө (харах дээрх тайлбар)
  signatureUrl    String?
  mileageAtReport Int?
  notes           String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  templateId String
  template   DiagnosticTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // Захиалгад хавсаргасан байж болно (заавал биш — мобайл дээр ширхэгээр үүсэх боломжтой)
  orderId String?
  order   ServiceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  filledById String?
  filledBy   User?   @relation("DiagnosticReportFilledBy", fields: [filledById], references: [id], onDelete: SetNull)

  // Энэ тайланг бөглөхөд зориулж захиалгад нэмсэн үйлчилгээний мөр (байвал) —
  // ServiceItem талд байгаа diagnosticReportId-ийн эсрэг тал.
  serviceItem ServiceItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, orderId])
  @@index([tenantId, maxSeverity])
  @@index([vehicleId])
  @@index([customerId])
  @@index([branchId])
  @@index([templateId])
}

// --- Category (үйлчилгээний ангилал — Ажил/Оношилгоо/Сэлбэг бүгдэд) -------
// Урьд "ажлын ангилал" байсныг өргөтгөж бүх төрлийн Service-д ашиглана.
// Салбартай олон-олон холбоотой: тухайн ангилал аль салбаруудад санал
// болгогдох вэ. Салбар оноогоогүй бол БҮХ салбарт хамаарна (нээлттэй). Онлайн
// цаг захиалгад үйлчлүүлэгч тухайн салбарын ангиллаас сонгож болно.
model Category {
  id          String  @id @default(cuid())
  name        String // "Хөдөлгүүр", "Тоормос", "Цахилгаан", "Угаалга" г.м.
  description String?
  isActive    Boolean @default(true)

  // Онлайн захиалгын slot урт тооцоход хэрэглэх tenant-ийн default үргэлжлэх
  // хугацаа (минут). null бол платформын 30 мин руу буурна (durationMinutes ?? 30).
  durationMinutes Int?

  // Энэ ажлыг НЭГ зэрэг хэдэн захиалга зэрэг хийж болохыг заана (ж: 2 бол
  // ижил цагт 2 үйлчлүүлэгчийн захиалгыг зэрэг авна). Формд шинэ ангилал
  // үүсгэхэд 1-ээр урьдчилан бөглөгдөж, засах боломжтой.
  concurrentCapacity Int @default(1)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Системийн ангилал (system admin удирддаг, платформ даяарх нэгдсэн
  // "ажлын" түлхүүр — ж: "Моторын тос солих") — ЗААВАЛ, ангилал бүр яг нэг
  // түлхүүрт холбогдоно (тодорхой түлхүүр тохирохгүй бол "Ерөнхий" ашиглана).
  // Олон тенантын өөр өөрийн Category мөр нэг ижил түлхүүрт холбогдож болно.
  // /discover (нийтэд нээлттэй каталог) дээр байгууллага сонгохоос өмнө энэ
  // түлхүүрээр хайж, аль салбар тухайн ажлыг хийдгийг олоход ашиглана.
  // onDelete Restrict — ашиглагдаж буй түлхүүрийг устгаж болохгүй (харах:
  // app/_actions/system-service-keys.ts-ийн archive-if-used).
  systemServiceKeyId String
  systemServiceKey   SystemServiceKey @relation(fields: [systemServiceKeyId], references: [id], onDelete: Restrict)

  // Олон-олон: ангилал санал болгогдох салбарууд (хоосон бол бүх салбарт).
  branches            Branch[]
  services            Service[]
  diagnosticTemplates DiagnosticTemplate[]
  appointments        Appointment[]
  appointmentLinks    AppointmentCategory[] // олон-ангилалт захиалгын M2M холбоос
  orderLinks          ServiceOrderCategory[] // засварын хуудсан дээрх snapshot холбоос

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@index([systemServiceKeyId])
}

// --- SystemServiceKey (систем admin удирддаг, платформ даяарх ажлын ----------
// каталог) — /discover дээр байгууллага сонгохоос өмнө "ямар ажил хийлгэх
// гэж байгаагаа" сонгож, тухайн ажлыг хийдэг салбаруудыг олоход ашиглана.
// Тенант бүр өөрийн Category-г энэ түлхүүрт заавал биш холбож болно.
model SystemServiceKey {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdById String?
  createdBy   SuperAdmin? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories Category[]

  @@index([isActive])
}

// --- BranchTag (систем admin удирддаг, платформ даяарх бизнесийн төрлийн ----
// шошго — жишээ: "Угаалгын газар", "Дугуй засвар") — /discover дээр байгууллага
// хайхад бизнесийн төрлөөр шүүхэд ашиглана. Category-с ялгаатай нь: тенант тус
// бүрийн өөрийн бичлэг биш, Branch-тай шууд олон-олон холбоотой (тухайн
// салбарт тохирох тодорхой хугацаа/багтаамж зэрэг нэмэлт талбар шаардахгүй
// учир Category шиг тенантын завсрын бичлэг хэрэггүй).

model BranchTag {
  id          String  @id @default(cuid())
  name        String  @unique // "Угаалгын газар", "Дугуй засвар" г.м.
  description String?
  isActive    Boolean @default(true)

  createdById String?
  createdBy   SuperAdmin? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  branches Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// --- AppointmentCategory (Appointment ↔ Category M2M холбоос) -------------
// Нэг захиалга олон үйлчилгээний ангилал хамарна. Explicit join model —
// ирээдүйд мөр тус бүрд тухайн үед quote хийсэн хугацаа/үнэ зэргийг snapshot
// хийх боломжтой (implicit M2M-д боломжгүй).
model AppointmentCategory {
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  // Restrict — захиалгын түүхийг хамгаалж, ашиглагдаж буй ангиллыг hard-delete
  // хийхээс сэргийлнэ (ангилал ердийн үед isActive=false-оор soft-delete хийгддэг).
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@id([appointmentId, categoryId])
  @@index([categoryId])
}

// --- ServiceOrderCategory (засварын хуудасны хүсэлтийн ангиллын snapshot) --
// Appointment-аас засварын хуудас үүсгэхэд хэрэглэгчийн сонгосон ангиллыг
// billable ServiceItem үүсгэлгүйгээр хадгална. `name` нь тухайн үеийн нэрийн
// snapshot тул ангиллын нэр дараа өөрчлөгдсөн ч захиалагчийн хүсэлт түүхэнд
// хэвээр үлдэнэ. Ажилтан бодит ажил/сэлбэг/оношилгоог ServiceItem-ээр өөрөө
// нэмж, хасаж, үнэ тооцно.
model ServiceOrderCategory {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId    String
  order      ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name       String
  createdAt  DateTime     @default(now())

  @@unique([orderId, categoryId])
  @@index([tenantId, orderId])
  @@index([categoryId])
}

// --- OrderTimeBooking (D-068: захиалгын олон удаагийн цаг эзэмшил) --------
// ServiceOrder.scheduledAt/startedAt/expectedFinishAt/occupiesCapacity нь нэг
// боломжит хугацааг л илэрхийлдэг байсан (тэдгээр талбар одоо ч хадгалагдана,
// хамгийн сүүлийн/одоогийн OrderTimeBooking мөрийн денормализацитай кэш болно —
// шууд харах/эрэмбэлэхэд л ашиглагдана, багтаамж тооцоололд биш). Энэ хүснэгт
// тэр захиалгыг ХЭДЭН ч удаа тусад нь эзэмшсэн бодит, өөрчлөгдөшгүй (append-only)
// хугацааны мөрүүдээр илэрхийлнэ — сэлбэг хүлээж ажлын байрыг суллаад дараа нь
// сэргээх, эсвэл машин өөр өдөр буцаж ирэх мэт тохиолдлыг нэг мутацлагддаг
// snapshot биш, бие даасан түүхэн мөрүүдээр бүртгэнэ. Хаагдсан (closedAt !=
// null) мөрийг хэзээ ч дахин засахгүй — шинэ үе шат бол шинэ мөр.
model OrderTimeBooking {
  id       String       @id @default(cuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId  String
  order    ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Order.branchId-аас үүсгэх үед хуулж авсан снапшот — захиалга хожим өөр
  // салбар руу шилжсэн ч энэ мөрийн түүхэн бодит байршил өөрчлөгдөхгүй.
  branchId String
  branch   Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)

  kind                    OrderBookingKind
  startAt                 DateTime
  // NULL = дуусах хугацаа тодорхойгүй (одоогийн "тооцоолол алга" төлөвтэй адил).
  // S13 `applyScheduleClips` may shorten this to fit a new closing time —
  // see `originalDurationMinutes` for the value as originally planned.
  endAt                   DateTime?
  // S13: minutes between startAt and the originally planned endAt, set once
  // when this row is created (SCHEDULED) and never rewritten afterward — lets
  // a later clip of `endAt` be distinguished from what was first promised.
  // null for rows created before this column existed, or with no planned end.
  originalDurationMinutes Int?
  // Энэ мөр хэзээ идэвхгүй болсныг тэмдэглэнэ (түр зогсоосон/дуусгасан/
  // цуцалсан) — NULL = хараахан нээлттэй, тухайн захиалгын одоогийн бодит
  // эзэмшил. Нэг захиалгад нэгэн зэрэг нэгээс олон нээлттэй мөр байх ёсгүй —
  // DB-д partial unique index-ээр (orderId, kind) WHERE closedAt IS NULL
  // хэлбэрээр хамгаалагдана (харах: migrations/20260911011720_order_time_booking_open_unique),
  // Prisma schema DSL нөхцөлт unique илэрхийлэх боломжгүй тул raw SQL-д байна.
  closedAt                DateTime?

  createdById String?
  createdBy   User?    @relation("OrderTimeBookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([tenantId, branchId, startAt])
  @@index([orderId])
}

enum OrderBookingKind {
  SCHEDULED // Ирээгүй, товлогдсон цаг — startAt ирээдүйд, ажил хараахан эхлээгүй
  ACTIVE // Машин бодитоор ажлын байранд байгаа хугацаа
}

// --- Unit (хэмжих нэгж — ширхэг, цаг, литр, г.м.) -------------------------

model Unit {
  id       String  @id @default(cuid())
  name     String // "ширхэг", "цаг", "литр", "кг", г.м.
  code     String? // богино тэмдэглэгээ — "ш", "ц", "л", "кг"
  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services           Service[] @relation("ServiceUnit")
  servicesAsDuration Service[] @relation("ServiceDurationUnit")

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// --- QPaySettings (платформын merchant — singleton) ----------------------

model QPaySettings {
  id                    Int       @id @default(1)
  username              String
  password              String
  invoiceCode           String
  callbackUrl           String?
  accessToken           String?
  refreshToken          String?
  tokenExpiresAt        DateTime?
  refreshTokenExpiresAt DateTime?
  updatedAt             DateTime  @updatedAt
}

// --- TenantQPaySettings (байгууллагын merchant — захиалгын төлбөрт) ------
// Тенант тус бүр өөрийн QPay merchant credentials оруулна. Захиалгын
// төлбөрийг үйлчлүүлэгчээс шууд авахын тулд ашиглана. Платформын
// `QPaySettings` нь зөвхөн subscription-д.

model TenantQPaySettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  username    String
  password    String // TODO: production-д шифрлэх
  invoiceCode String
  callbackUrl String?

  enabled Boolean @default(true)

  // Token кэш
  accessToken           String?
  refreshToken          String?
  tokenExpiresAt        DateTime?
  refreshTokenExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- OrderPayment (захиалгын төлбөр — QPay invoice) ----------------------

enum OrderPaymentMethod {
  QPAY
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum OrderPaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

model OrderPayment {
  id String @id @default(cuid())

  // Санхүүгийн бичлэг — tenant/order устахад дагаад устахгүй (Restrict).
  // Устгахын өмнө холбогдох OrderPayment-уудыг ил тод шийдвэрлэх ёстой
  // (жишээ нь deleteOrderAction — зөвхөн PENDING/CANCELLED/FAILED-ийг цэвэрлээд,
  // PAID байвал устгахыг блоклоно).
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  orderId String
  order   ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("MNT")

  method OrderPaymentMethod @default(QPAY)
  status OrderPaymentStatus @default(PENDING)

  // QPay-аас ирсэн талбарууд
  qpayInvoiceId String?
  qpayPaymentId String?
  qrImage       String? // base64
  qrText        String? // QPay deep link
  qpayUrls      Json? // bank app deep links array
  paidAt        DateTime?

  // Хүлээн авсан банк (BANK_TRANSFER/CARD үед заавал; CARD-д POS-ийн банк).
  // Код нь lib/banks.ts-д — DB enum биш (жагсаалт кодоор өөрчлөгдөнө).
  bank String?

  // Дараа тооцооны нэг мөнгөн гүйлгээгээр (PostpaidSettlement) хаагдсан төлбөр
  // (Phase C2). Тэр үед кассын орлогыг settlement нэг дор бичнэ.
  settlementId String?
  settlement   PostpaidSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, bank])
  @@index([orderId])
  @@index([qpayInvoiceId])
  @@index([settlementId])
}

// --- Cash ledger (Phase C1) -----------------------------------------------

enum CashDirection {
  INCOME
  EXPENSE
}

// Орлого/зарлагын төрөл. systemKey != null бол систем төрөл — нэр, идэвх, устгал түгжигдсэн.
model CashTransactionType {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  direction CashDirection
  name      String
  systemKey String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  transactions CashTransaction[]

  @@unique([tenantId, direction, name])
  @@unique([tenantId, systemKey])
}

// Кассын бичлэг — зөвхөн нэмэгдэнэ; засах/устгах байхгүй, зөвхөн хүчингүй болгоно (void).
// orderPaymentId/orderId нь FK биш (захиалга/төлбөр устахад санхүүгийн бичлэг үлдэнэ).
model CashTransaction {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  direction      CashDirection
  typeId         String
  type           CashTransactionType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  amount         Decimal             @db.Decimal(12, 2)
  method         OrderPaymentMethod
  bank           String?
  occurredAt     DateTime
  note           String?
  attachmentPath String?
  // Татвар (туршилт) — зөвхөн зарлагад; ямар ч нийлбэрт орохгүй.
  taxIncluded    Decimal?            @db.Decimal(12, 2)
  customerId     String?
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  counterparty   String?
  orderPaymentId String?             @unique
  orderId        String?
  settlementId   String?
  settlement     PostpaidSettlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  sessionId      String?
  session        CashSession?        @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User                @relation("CashTransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedAt       DateTime?
  voidedById     String?
  voidedBy       User?               @relation("CashTransactionVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason     String?
  createdAt      DateTime            @default(now())

  @@index([tenantId, branchId, occurredAt])
  @@index([tenantId, direction, typeId])
  @@index([sessionId])
  @@index([orderId])
  @@index([settlementId])
}

// Дараа тооцооны нэгтгэсэн төлөлт (Phase C2).
model PostpaidSettlement {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId    String
  branch      Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customerId  String
  customer    Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount      Decimal            @db.Decimal(12, 2)
  method      OrderPaymentMethod
  bank        String?
  createdById String
  createdBy   User               @relation("PostpaidSettlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?              @relation("PostpaidSettlementVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason  String?

  payments     OrderPayment[]
  transactions CashTransaction[]

  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, customerId])
}

// Кассын ээлж (Phase C3).
// !! WARNING: this model has a PARTIAL UNIQUE INDEX that Prisma cannot model (no preview flag enabled):
// !!   "CashSession_one_open_per_branch_key" ON ("branchId") WHERE "closedAt" IS NULL
// !! It exists ONLY in SQL (migration 20261006180000_cash_indexes_one_open_session). A generated
// !! `prisma migrate dev` migration may propose DROP INDEX for it: NEVER accept that drop; remove the
// !! DROP INDEX line from any generated migration. It is the DB backstop for "one OPEN session per branch".
model CashSession {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedById   String
  openedBy     User      @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  openedAt     DateTime
  openingCash  Decimal   @db.Decimal(12, 2)
  closedById   String?
  closedBy     User?     @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt     DateTime?
  countedCash  Decimal?  @db.Decimal(12, 2)
  expectedCash Decimal?  @db.Decimal(12, 2)
  difference   Decimal?  @db.Decimal(12, 2)
  note         String?

  transactions CashTransaction[]
  methodCounts CashSessionMethodCount[]

  @@index([tenantId, branchId, closedAt])
  @@index([tenantId, branchId, openedAt])
  // NOT expressible in Prisma: partial unique index "CashSession_one_open_per_branch_key" ON ("branchId") WHERE "closedAt" IS NULL
  // (one OPEN session per branch). Lives only in migration 20261006180000_cash_indexes_one_open_session.
}

// Per-(method, bank) close figures of a session (Odoo-style register close). Frozen at close.
// bank is NOT nullable: "" means "no bank" (CASH/QPAY/OTHER), so the composite unique below really is
// unique (Postgres treats NULLs as distinct in a unique index).
model CashSessionMethodCount {
  id         String             @id @default(cuid())
  tenantId   String
  sessionId  String
  session    CashSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  method     OrderPaymentMethod
  bank       String             @default("")
  expected   Decimal            @db.Decimal(12, 2)
  counted    Decimal?           @db.Decimal(12, 2)
  difference Decimal?           @db.Decimal(12, 2)

  @@unique([sessionId, method, bank])
  @@index([tenantId])
}

// --- SubscriptionPayment (тенант төлбөр + QPay invoice) -----------------

enum SubscriptionPaymentMethod {
  QPAY
  BANK_TRANSFER
  CASH
  OTHER
}

enum SubscriptionPaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
}

model SubscriptionPayment {
  id String @id @default(cuid())

  // Санхүүгийн бичлэг — tenant устахад дагаад устахгүй (Restrict).
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  // Snapshot fields — PlanPrice устсан ч мэдээлэл хадгалагдана
  plan     Plan
  period   BillingPeriod
  amount   Decimal       @db.Decimal(12, 2)
  currency String        @default("MNT")

  planPriceId String?
  planPrice   PlanPrice? @relation(fields: [planPriceId], references: [id], onDelete: SetNull)

  method SubscriptionPaymentMethod @default(QPAY)
  status SubscriptionPaymentStatus @default(PENDING)

  // QPay-аас ирсэн талбарууд
  qpayInvoiceId String?
  qpayPaymentId String?
  qrImage       String? // base64 (data URL-руу хувиргаж харуулна)
  qrText        String? // deep link
  qpayUrls      Json? // bank app deep links array
  paidAt        DateTime?

  // PAID болсон үед энэ payment-аас үүссэн subscription
  createdSubscriptionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([qpayInvoiceId])
}

// --- PlanPrice (super admin тогтоодог багц үнийн жагсаалт) ---------------

enum BillingPeriod {
  MONTH
  QUARTER
  YEAR
}

model PlanPrice {
  id        String        @id @default(cuid())
  plan      Plan
  period    BillingPeriod
  amount    Decimal       @db.Decimal(12, 2)
  currency  String        @default("MNT")
  isActive  Boolean       @default(true)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  payments SubscriptionPayment[]

  @@unique([plan, period, currency])
  @@index([isActive])
}

// --- PlanFeature (багц бүрийн "юу багтсан" жагсаалт — super admin засварлана) -

model PlanFeature {
  id          String   @id @default(cuid())
  plan        Plan
  label       String // "Хамгийн их хэрэглэгч"
  value       String // "20", "Хязгааргүй", "Тийм", "—"
  description String? // tooltip / урт тайлбар
  sortOrder   Int      @default(0)
  highlighted Boolean  @default(false) // pricing card-д тод харагдуулах
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([plan, sortOrder])
}

// --- PlanLimit (багц тус бүрийн машин шалгадаг хязгаар) -------------------
// `code` нь програмын дотор тогтсон key (max_users, daily_orders, ...).
// SuperAdmin зөвхөн тоон утга / boolean утгыг өөрчилнө. Кодын жагсаалт нь
// `lib/plan-limits.ts` дотор төвлөрсөн.

enum PlanLimitKind {
  COUNT // тоон quota — intValue null бол хязгааргүй
  BOOLEAN // боломж нээх/хаах flag
}

model PlanLimit {
  id          String        @id @default(cuid())
  plan        Plan
  code        String // ж: "max_users", "daily_orders"
  label       String // дэлгэцэнд харуулах нэр
  description String?
  kind        PlanLimitKind @default(COUNT)
  intValue    Int? // COUNT — null=хязгааргүй
  boolValue   Boolean? // BOOLEAN
  sortOrder   Int           @default(0)
  highlighted Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([plan, code])
  @@index([plan, sortOrder])
}

// --- Subscription (тенант бүрийн багц, түүх + 14 хоногийн trial) ---------

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id     String             @id @default(cuid())
  plan   Plan
  status SubscriptionStatus

  startsAt DateTime
  endsAt   DateTime? // null бол байнгын/тогтоогдоогүй (paid no-expiry); TRIAL үед заавал

  amount      Decimal?  @db.Decimal(12, 2) // төлсөн дүн (заавал биш)
  notes       String?
  cancelledAt DateTime?

  // Хугацаа дуусах сануулга илгээсэн цаг — cron давхар илгээхээс сэргийлнэ.
  reminderSentAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // SuperAdmin гараар үүсгэсэн бол лавлана. Signup-аас үүсэх trial-д null.
  createdById String?
  createdBy   SuperAdmin? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([endsAt])
}

// --- OTP (6 оронтой нэг удаагийн код — signup, нууц үг шинэчлэх г.м.) ----

enum OtpType {
  SIGNUP
  CHANGE_PASSWORD
  RESET_PASSWORD
  CONSUMER_LOGIN // онлайн цаг захиалгын Account утсаар нэвтрэх
  SET_PASSWORD // ажилтны анхны нэвтрэлт — нууц үг үүсгэж аккаунт идэвхжүүлэх
  ACCOUNT_CLOSE // аккаунт хаах/устгах баталгаажуулалт
}

model Otp {
  id       String  @id @default(cuid())
  // Хүлээн авагчийг email ЭСВЭЛ phone-оор холбоно. Ажилтан/тенантын урсгал
  // (SIGNUP/CHANGE/RESET) email-ээр, Account-ийн CONSUMER_LOGIN утсаар явна.
  email    String?
  phone    String? // 8 оронтой канон формат (lib/phone.ts)
  codeHash String // зургаан оронтой код-н sha256 hex (раw код DB-д хадгалахгүй)
  type     OtpType
  attempts Int     @default(0) // буруу баталгаажуулсан удаа

  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  // Тэмдэглэлүүд — аудит, "хэн илгээсэн" болон шинэ нууц үг боловсруулахдаа useful
  userId    String? // байгаа хэрэглэгчийн change/reset үед бичнэ (signup-д null)
  accountId String? // CONSUMER_LOGIN — байгаа Account-д бичнэ (анхны нэвтрэлтэд null)
  ip        String?
  userAgent String?

  @@index([email, type])
  @@index([phone, type])
  @@index([expiresAt])
  @@index([userId])
}

// --- Account (эцсийн хэрэглэгч — олон тенант хооронд цаг захиалагч) --------
// Тенантаас үл хамаарах global бүртгэл. Утсаар (OTP) нэвтэрнэ — нууц үггүй.
// Цаг захиалах үед тухайн тенантын [[Customer]]-той утсаар нь холбогдоно
// (Customer.accountId). User (ажилтан) болон SuperAdmin-аас тусдаа principal.
model Account {
  id        String  @id @default(cuid())
  phone     String  @unique // 8 оронтой канон формат (lib/phone.ts)
  name      String?
  email     String?
  avatarUrl String?
  isActive  Boolean @default(true) // false бол нэвтрэлт блоклогдоно
  // Хэрэглэгч өөрөө түр хаасан. Дахин нэвтрэхэд null болно (isActive-аас тусдаа —
  // isActive=false бол админ блоклосон, нэвтрэлтээр сэргэхгүй).
  deactivatedAt DateTime?
  // Бүрмөсөн устгасан (PII арилгасан tombstone). Буцаагдахгүй.
  deletedAt     DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customers     Customer[]
  appointments  Appointment[]
  vehicles      AccountVehicle[]
  devices       Device[]
  notifications Notification[]
  feedback      Feedback[]
  payments      AppointmentPayment[]
}

// --- AccountVehicle (Account ↔ global Vehicle холбоо) --------------------
// Хэрэглэгчийн "миний машинууд" — global [[Vehicle]] руу заасан нимгэн link.
// Машины бие даасан шинж (марк, өнгө г.м.) global Vehicle дээр төвлөрсөн тул
// энд давхардуулахгүй. Цаг захиалахад сонгоно; баталгаажуулахад тухайн
// тенантад [[TenantVehicle]] link үүсгэнэ (snapshot хуулалт байхгүй).
//
// АНХААР: энэ link нь хэрэглэгч ӨӨРӨӨ нэмдэг (эзэмшил баталгаажаагүй) тул
// cross-tenant түүхийн эзэмшлийн нотолгоо БОЛОХГҮЙ — түүнд `TenantVehicle`-ийн
// account-той холбоотой Customer-ийг ашиглана (account/history).
model AccountVehicle {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments Appointment[]

  @@unique([accountId, vehicleId])
  @@index([accountId])
  @@index([vehicleId])
}

// --- Appointment (онлайн цаг захиалгын хүсэлт) ----------------------------
// Account вэб/аппаас цаг хүсэхэд PENDING-ээр үүснэ. Ажилтан баталгаажуулахад
// тенантын [[Customer]]-той утсаар нь холбогдож (Customer.accountId), дараа нь
// одоо байгаа [[ServiceOrder]] урсгалаар бодит захиалга үүснэ.
enum AppointmentStatus {
  PENDING // хэрэглэгч илгээсэн, ажилтан хариу өгөөгүй
  CONFIRMED // ажилтан баталгаажуулсан
  REJECTED // ажилтан татгалзсан
  CANCELLED // хэрэглэгч цуцалсан
  NO_SHOW // товлосон цагт ирээгүй
}

model Appointment {
  id                               String            @id @default(cuid())
  status                           AppointmentStatus @default(PENDING)
  requestedAt                      DateTime // хэрэглэгчийн хүссэн цаг
  // Effective reserved duration — hours/exception/season changes (S13
  // `applyScheduleClips`) may shorten THIS value to fit a new closing time.
  // null preserves unknown historical estimates and supports older application writers.
  estimatedDurationMinutes         Int?
  // S13: the original booking-time duration snapshot, set once at creation and
  // NEVER rewritten by clipping — lets staff see what was originally promised
  // even after a later hours change shortened `estimatedDurationMinutes`.
  // null for rows created before this column existed.
  originalEstimatedDurationMinutes Int?
  // Actual customer arrival/check-in; does not mean work has started.
  arrivedAt                        DateTime?
  note                             String?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  // Онлайн захиалгад Account-той. Ажилтан утсаар бүртгэсэн (phone-in) бол null —
  // энэ тохиолдолд customerId-г шууд оноож, status CONFIRMED-ээр үүснэ.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Онлайн: баталгаажуулах үед утсаар resolve хийгдэнэ. Phone-in: шууд оноогдоно.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Онлайн захиалгад хэрэглэгчийн сонгосон global машин (заавал биш).
  accountVehicleId String?
  accountVehicle   AccountVehicle? @relation(fields: [accountVehicleId], references: [id], onDelete: SetNull)

  // Онлайн захиалгад хэрэглэгчийн сонгосон үйлчилгээний ангилал (заавал биш).
  // DEPRECATED (2026-09-07, booking v2): олон ангилал `categories`
  // (AppointmentCategory) руу шилжсэн. Хуучин мөр болон phone-in-тэй нийцтэй
  // байлгах үүднээс ХАДГАЛАВ — backfill-ийн дараа шинэ код `categories`-г
  // уншина. Дараагийн цэвэрлэгээгээр устгана (энэ migration-д УСТГАХГҮЙ).
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Олон-ангилалт захиалга — сонгосон бүх үйлчилгээний ангилал (M2M).
  categories AppointmentCategory[]

  // Баталгаажуулахад тенантын Vehicle руу snapshot хийгдсэн машин.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  // Баталгаажсаны дараа үүсгэсэн захиалга (1:1).
  serviceOrderId String?       @unique
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  // Ажилтны хариу — хурдан унших талбарууд (дэлгэрэнгүй нь AuditLog-д).
  respondedAt   DateTime?
  respondedById String?
  respondedBy   User?     @relation("AppointmentRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)

  // QA #28: цагт хариуцах мастер (заавал биш). Засварын хуудас үүсэхэд
  // ServiceOrder.assignedToId руу урьдчилан бөглөгдөнө.
  assignedToId String?
  assignedTo   User?   @relation("AppointmentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  // Сануулга SMS илгээсэн эсэх (cron давхар илгээхгүйн тулд).
  reminderSentAt DateTime?

  // Хураамжийн QPay checkout — ЗӨВХӨН явцад буй (төлөгдөөгүй) оролдлогыг
  // хөтөлнө (AppointmentPayment "Invoice" мөр ТӨЛӨГДСӨНИЙ дараа л үүснэ,
  // энэ талбарууд түр зуурын). feeAmount/feeCurrency нэхэмжлэл хүсэгдсэн
  // үеийн тохиргооны snapshot.
  feeAmount        Decimal? @db.Decimal(12, 2)
  feeCurrency      String?
  feeQpayInvoiceId String?
  feeQrImage       String?
  feeQrText        String?
  feeQpayUrls      Json? // bank app deep links array

  // QPay-аас "дутуу" (0 < төлсөн дүн < feeAmount) төлбөр илэрвэл тэмдэглэнэ
  // — Invoice ҮҮСГЭХГҮЙ (confirmAppointmentPayment), гагцхүү account/ажилтанд
  // "дутуу төлсөн" гэдгийг харуулах зорилготой. Бүрэн төлөгдмөгц цэвэрлэнэ.
  feeUnderpaidAmount Decimal?  @db.Decimal(12, 2)
  feeUnderpaidAt     DateTime?

  // Хураамж төлөгдсөний дараа ГАНЦХАН удаа үүсэх "Invoice" (санхүүгийн
  // бичлэг — платформын орлого). Төлбөр амжилтгүй/хүлээгдэж буй үед энэ
  // мөр байхгүй.
  payment AppointmentPayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([branchId, requestedAt])
  @@index([accountId])
  @@index([categoryId])
  @@index([respondedById])
  @@index([assignedToId])
  @@index([status, requestedAt, reminderSentAt])
}

// --- AppointmentPayment (цаг захиалгын хураамжийн Invoice — платформын
// (SuperAdmin) орлого) -----------------------------------------------------
// Хэрэглэгч захиалахдаа Appointment.fee* талбаруудаар QPay invoice татаж
// (lib/appointment-payments.ts: ensureAppointmentFeeCheckout) QR уншуулна.
// Энэ мөр ЗӨВХӨН QPay-аас "PAID" гэж баталгаажсаны дараа л (confirmAppointmentPayment)
// нэг удаа үүснэ — амжилтгүй/хүлээгдэж буй оролдлого DB-д Invoice болж
// хадгалагдахгүй. SubscriptionPayment/OrderPayment-тэй ижил хэлбэрийн QPay
// урсгал, гагцхүү системийн (платформын) QPaySettings ашигладгаараа
// TenantQPaySettings ашигладаг OrderPayment-ээс ялгаатай.

// Практикт зөвхөн PAID үүснэ (доорх тайлбарыг үз) — бусад утгууд хуучин
// өгөгдөлтэй нийцтэй байлгах, ирээдүйд буцаан татах/цуцлах (refund) зэрэгт
// зориулж enum-д үлдээв.
enum AppointmentPaymentStatus {
  PENDING
  PAID
  CANCELLED
  FAILED
  REFUNDED
}

model AppointmentPayment {
  id String @id @default(cuid())

  // Санхүүгийн бичлэг — appointment/tenant/account устахад дагаад устахгүй
  // (Restrict), OrderPayment/SubscriptionPayment-тэй адил зарчим.
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("MNT")

  status AppointmentPaymentStatus @default(PENDING)

  // QPay-аас ирсэн талбарууд
  qpayInvoiceId String?
  qpayPaymentId String?
  qrImage       String? // base64
  qrText        String? // QPay deep link
  paidAt        DateTime?

  // "P2P" (банкны шилжүүлэг/QR) эсвэл "CARD" — QPay.payment/check хариунаас.
  // Буцаалтын боломжтой эсэхийг үүгээр шийднэ: QPay-ийн refund/cancel API
  // ЗӨВХӨН CARD гүйлгээнд ажилладаг тул P2P бол гараар (bank transfer-ээр)
  // буцааж, зөвхөн энд тэмдэглэнэ.
  paymentType String?

  // Буцаалт — SuperAdmin гараар (P2P) эсвэл QPay refund API-аар (CARD) хийнэ.
  refundedAt   DateTime?
  refundNote   String?
  refundedById String?
  refundedBy   SuperAdmin? @relation(fields: [refundedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([accountId, status])
  @@index([qpayInvoiceId])
}

// --- RefreshToken (мобайл клиентэд зориулсан, эргүүлдэг token) -----------

model RefreshToken {
  id        String @id @default(cuid())
  tokenHash String @unique // түүхий token-ы sha256 hex
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?       @unique // rotation хэлхээ — энэ token-ийг ямар token орлоосон бэ (нэг шинэ token зөвхөн нэг хуучинтай холбогдоно)
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedFrom RefreshToken? @relation("TokenRotation")
  userAgent    String?
  ip           String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// --- UserSession (ажилтны web нэвтрэлт — төхөөрөмж/түүх + revoke) --------
// Web cookie session-ийг DB-д хөтөлж, "нэвтэрсэн төхөөрөмжүүд"-ийг харах,
// тус бүрийг алсаас "гаргах" (revoke) боломжтой болгоно. JWT-д session id (sid)
// шигтгэж, getSession бүрт энэ бичлэгийг шалгана.
model UserSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?
  ip        String?

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// --- Device (web/мобайл төхөөрөмж — push notification-д) -----------------
// FCM (firebase) token + төхөөрөмжийн мета. Эзэн нь User (ажилтан) ЭСВЭЛ
// Account (хэрэглэгч). Клиент `deviceId`-аар upsert хийж, нэвтрэх бүрт эзнийг
// шинэчилнэ (нэг install дээр өөр хэрэглэгч нэвтэрвэл эзэн дамждаг).
enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

model Device {
  id            String         @id @default(cuid())
  deviceId      String         @unique // клиентийн үүсгэсэн install id
  platform      DevicePlatform
  firebaseToken String? // FCM push token
  name          String? // "Bat's iPhone"
  model         String? // "iPhone 14 Pro" / "SM-G991B"
  os            String? // "iOS 17.2" / "Android 14" / "Windows"

  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String?
  account      Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([accountId])
  @@index([superAdminId])
  @@index([firebaseToken])
}

// --- Notification (мэдэгдэлийн төв + түүх — ажилтан ба Account хоёуланд) ----
// Илгээгдсэн push мэдэгдэл бүрийг хадгална. Эзэн нь User (ажилтан) ЭСВЭЛ Account
// (хэрэглэгч) — `Device` model шиг яг нэг нь утгатай (XOR check constraint-аар
// баталгаажна). Уншаагүй тоо/жагсаалт/түүхэнд ашиглана. Шинэ мэдэгдэл нь хүлээн
// авагч тус бүрд нэг мөр (fan-out) болж үүснэ.
model Notification {
  id String @id @default(cuid())

  // Ажилтны мөрд тенант/салбарын context (cleanup, шүүлтэд). Account-д null.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Хүлээн авагч — яг нэг нь утгатай (migration дахь XOR check constraint).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  superAdminId String?
  superAdmin   SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  type  String // registry key — "appointment_confirmed", "appointment_created" г.м.
  title String
  body  String
  data  Json? // deep-link бүтээхэд — { appointmentId, orderId, ... }

  // Идемпотент event-д давхар үүсэхээс сэргийлнэ ("type:appointmentId"). Бусдад null.
  dedupeKey String? @unique

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([accountId, readAt])
  @@index([superAdminId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
  @@index([superAdminId, createdAt(sort: Desc)])
}

// --- Feedback (хэрэглэгчийн санал хүсэлт / алдааны мэдээллэл) -------------
// Ажилтан (User) ЭСВЭЛ Account аль нэгээс ирнэ, SuperAdmin `/system/feedback`-д
// хянана. Notification-той адил Account талын мөрд tenantId null (зөвхөн
// bypass_rls горимд уншигдана — 20260813070000 migration-ийн адил policy).
enum FeedbackType {
  BUG
  SUGGESTION
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_REVIEW
  RESOLVED
  DISMISSED
}

model Feedback {
  id String @id @default(cuid())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  type          FeedbackType
  message       String
  screenshotUrl String?
  pageUrl       String?
  userAgent     String?

  status     FeedbackStatus @default(NEW)
  adminNote  String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  messages FeedbackMessage[]

  @@index([status, createdAt(sort: Desc)])
  @@index([tenantId])
  @@index([userId])
  @@index([accountId])
}

enum FeedbackMessageAuthor {
  ADMIN
  SUBMITTER
}

// Feedback дээрх хоёр талын харилцан яриа — SuperAdmin (ADMIN) ба анх
// илгээгч (SUBMITTER, tenant талын ажилтан). tenantId нь Notification-той
// адил RLS-д зориулж Feedback-аас denormalize хийсэн.
model FeedbackMessage {
  id String @id @default(cuid())

  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  author  FeedbackMessageAuthor
  message String

  createdAt DateTime @default(now())

  @@index([feedbackId, createdAt])
  @@index([tenantId])
}

// --- PlatformSetting (нэг мөртэй global тохиргоо — SuperAdmin засна) ------
// Landing/footer-т харагдах сошиал холбоос г.м. Нэг л мөр (id="default").
model PlatformSetting {
  id          String  @id @default("default")
  facebookUrl String?
  youtubeUrl  String?

  // Цаг захиалгын хураамж (AppointmentPayment) — super admin засна. false бол
  // үнэгүй (хэрэглэгч захиалахдаа QPay invoice-гүй, шууд захиална).
  appointmentFeeEnabled Boolean @default(true)
  appointmentFeeAmount  Decimal @default(1000) @db.Decimal(12, 2)

  updatedAt DateTime @updatedAt
}

// --- SuperAdmin (carservice.mn-ын платформын эзэн) ---------------------------

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  // V2: олон super admin дэмжинэ (харах: app/system/(authed)/admins/) —
  // идэвхгүй болговол нэвтрэх боломжгүй болно, харин холбогдсон
  // subscriptionsCreated/refundedAppointmentPayments зэрэг түүхэн
  // мэдээллийг хадгалахын тулд мөрийг УСТГАХГҮЙ.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Аль admin урьсан/үүсгэсэн бэ (эхний, bootstrap admin-д null).
  createdById String?
  createdBy   SuperAdmin?  @relation("SuperAdminInvites", fields: [createdById], references: [id], onDelete: SetNull)
  invited     SuperAdmin[] @relation("SuperAdminInvites")

  subscriptionsCreated        Subscription[]
  devices                     Device[]
  notifications               Notification[]
  refundedAppointmentPayments AppointmentPayment[]
  createdDiagnosticTemplates  DiagnosticTemplate[]
  createdServiceKeys          SystemServiceKey[]
  createdBranchTags           BranchTag[]
}

// --- AuditLog (тенант доторх чухал үйлдлийн түүх) ------------------------
// Захиалгын статус өөрчлөлт, барааны нөөц хөдөлгөөн, мөр нэмэх/устгах
// зэрэг чухал үйлдлүүдийг бичнэ. `entity`/`entityId` нь полиморф холбоос
// — тус бүр Prisma relation үүсгэхгүй (хэт ихсэх тул). `summary` нь хүний
// уншимтгай нэг мөр, `before`/`after` нь сонгосон талбаруудын snapshot.

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  PAYMENT_CHANGE
  STOCK_CHANGE
  ITEM_ADDED
  ITEM_REMOVED
  ITEM_UPDATED
  ITEM_CANCELLED
  ITEM_STATUS_CHANGE
  LOGIN
  LOGOUT
  OTHER
}

model AuditLog {
  id       String      @id @default(cuid())
  entity   String // "ServiceOrder", "Service", "Customer", "Vehicle", "User", "Branch"
  entityId String
  action   AuditAction
  summary  String? // "SCHEDULED → IN_PROGRESS", "Stock decremented by 5 ш"
  before   Json?
  after    Json?

  // Аудитын бичлэг — tenant устахад дагаад устахгүй (Restrict).
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  userId String?
  user   User?   @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull)

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, action, createdAt])
  @@index([userId])
}

// --- Монголын засаг захиргааны нэгж (хаягийн лавлах) ----------------------
// scripts/mongolian.sql-аас seed-ээр ачаална. city = аймаг/нийслэл,
// district = сум/дүүрэг, khoroo = хороо/баг. id-г эх дугаараар нь хадгална
// (FK болон давтан seed-д тогтвортой).
model City {
  id   Int     @id
  code String?
  name String

  districts District[]
  khoroos   Khoroo[]
}

model District {
  id     Int     @id
  code   String?
  name   String
  cityId Int
  city   City    @relation(fields: [cityId], references: [id])

  khoroos Khoroo[]

  @@index([cityId])
}

model Khoroo {
  id         Int       @id
  name       String
  cityId     Int
  city       City      @relation(fields: [cityId], references: [id])
  // Заавал биш — зарим аймаг (ж: Дархан-Уул) дэх хороо шууд аймагт (District-гүйгээр)
  // харьяалагдана (эх өгөгдөлд бодитоор ажиглагдсан бүтэц, дата дутагдал биш).
  districtId Int?
  district   District? @relation(fields: [districtId], references: [id])

  @@index([cityId])
  @@index([districtId])
}
